# Application
APP_ENV=development
APP_NAME=OORCA
LOG_LEVEL=INFO
SECRET_KEY=change-me

# Database
DATABASE_URL=postgresql://oorca:oorca@localhost:5432/oorca
DATABASE_POOL_SIZE=10

# Redis / Queue
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=oorca
S3_SECRET_KEY=oorca-secret
S3_BUCKET_RAW=oorca-raw
S3_BUCKET_PROCESSED=oorca-processed

# External APIs
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
AIS_HUB_API_KEY=
MARINETRAFFIC_API_KEY=

# Model paths
SAR_MODEL_PATH=./models/sar/checkpoints
ATTRIBUTION_MODEL_PATH=./models/attribution/checkpoints

# OpenDrift
OPENDRIFT_OFFLINE_MODE=false